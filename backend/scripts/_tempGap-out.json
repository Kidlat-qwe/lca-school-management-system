Executed query {
  text: '\n' +
    '      WITH scoped_rows AS (\n' +
    '        SELECT\n' +
    '          cs.student_id,\n' +
    '          cs.class_id,\n' +
    '          COALESCE(cs.phase_number, 1) AS phase_number,\n' +
    '          cs.enrolled_at,\n' +
    '          cs.program_enrollment_status,\n' +
    '          cs.removed_at,\n' +
    '          cs.classstudent_id,\n' +
    '          c.start_date AS class_start_date\n' +
    '        FROM classstudentstbl cs\n' +
    '        INNER JOIN classestbl c ON cs.class_id = c.class_id AND c.branch_id = $2\n' +
    '        INNER JOIN installmentinvoiceprofilestbl ip\n' +
    '          ON ip.student_id = cs.student_id\n' +
    '         AND ip.class_id = cs.class_id\n' +
    '        WHERE cs.student_id = ANY($1::int[])\n' +
    "          AND COALESCE(cs.enrolled_by, '') NOT ILIKE '%Rejoin gap marker%'\n" +
    '          \n' +
    '          \n' +
    '          \n' +
    '      ),\n' +
    '      anchor AS (\n' +
    '        SELECT DISTINCT ON (student_id, class_id)\n' +
    '          student_id,\n' +
    '          class_id,\n' +
    '          phase_number AS base_phase,\n' +
    "          DATE_TRUNC('month', TIMEZONE('Asia/Manila', enrolled_at))::date AS base_month\n" +
    '        FROM scoped_rows\n' +
    '        WHERE enrolled_at IS NOT NULL\n' +
    '          \n' +
    "  AND program_enrollment_status IN ('new', 're_enrolled', 'upsell', 'rejoin', 'completed')\n" +
    '  AND removed_at IS NULL\n' +
    '\n' +
    '        ORDER BY student_id, class_id, phase_number ASC, enrolled_at ASC\n' +
    '      ),\n' +
    '      invoice_phase AS (\n' +
    '        SELECT\n' +
    '          ip.student_id,\n' +
    '          ip.class_id,\n' +
    '          COALESCE(\n' +
    "            (regexp_match(i.remarks, 'TARGET_PHASE:(\\d+)', 'i'))[1]::int,\n" +
    "            (regexp_match(i.invoice_description, 'phase\\s*(\\d+)', 'i'))[1]::int\n" +
    '          ) AS phase_number,\n' +
    "          TO_CHAR(i.due_date, 'YYYY-MM-DD') AS due_date_ymd,\n" +
    "          LOWER(TRIM(i.status)) = 'paid' AS is_paid\n" +
    '        FROM installmentinvoiceprofilestbl ip\n' +
    '        INNER JOIN invoicestbl i\n' +
    '          ON i.installmentinvoiceprofiles_id = ip.installmentinvoiceprofiles_id\n' +
    '        INNER JOIN invoicestudentstbl ist\n' +
    '          ON ist.invoice_id = i.invoice_id\n' +
    '         AND ist.student_id = ip.student_id\n' +
    '        INNER JOIN classestbl c ON c.class_id = ip.class_id AND c.branch_id = $2\n' +
    '        WHERE ip.student_id = ANY($1::int[])\n' +
    '          AND i.due_date IS NOT NULL\n' +
    "          AND COALESCE(i.status, '') NOT IN ('Cancelled', 'Canceled')\n" +
    '          AND (\n' +
    '            ip.downpayment_invoice_id IS NULL\n' +
    '            OR COALESCE(i.invoice_chain_root_id, i.invoice_id) <> ip.downpayment_invoice_id\n' +
    '          )\n' +
    '          \n' +
    '          \n' +
    '          \n' +
    '      ),\n' +
    '      invoice_billing AS (\n' +
    '        SELECT\n' +
    '          inv.student_id,\n' +
    '          inv.class_id,\n' +
    '          inv.phase_number,\n' +
    '          inv.due_date_ymd,\n' +
    '          inv.is_paid,\n' +
    '          TO_CHAR(\n' +
    '            (\n' +
    '              GREATEST(\n' +
    '                a.base_month,\n' +
    '                CASE\n' +
    '                  WHEN c.start_date IS NOT NULL THEN\n' +
    "                    DATE_TRUNC('month', TIMEZONE('Asia/Manila', c.start_date))::date\n" +
    '                  ELSE a.base_month\n' +
    '                END\n' +
    "              ) + ((inv.phase_number - a.base_phase)::int * INTERVAL '1 month')\n" +
    '            )::date,\n' +
    "            'YYYY-MM'\n" +
    '          ) AS billing_month_key\n' +
    '        FROM invoice_phase inv\n' +
    '        INNER JOIN anchor a\n' +
    '          ON a.student_id = inv.student_id\n' +
    '         AND a.class_id = inv.class_id\n' +
    '        INNER JOIN classestbl c ON c.class_id = inv.class_id\n' +
    '        WHERE inv.phase_number IS NOT NULL\n' +
    '          AND inv.phase_number >= a.base_phase\n' +
    '      ),\n' +
    '      unpaid_billing AS (\n' +
    '        SELECT\n' +
    '          student_id,\n' +
    '          class_id,\n' +
    '          billing_month_key,\n' +
    '          MAX(phase_number) AS phase_number,\n' +
    '          MAX(due_date_ymd) AS due_date_ymd\n' +
    '        FROM invoice_billing\n' +
    '        WHERE NOT is_paid\n' +
    '          AND billing_month_key IS NOT NULL\n' +
    '          AND due_date_ymd IS NOT NULL\n' +
    '        GROUP BY student_id, class_id, billing_month_key\n' +
    '      )\n' +
    '      SELECT\n' +
    '        student_id,\n' +
    '        class_id,\n' +
    '        billing_month_key,\n' +
    '        phase_number,\n' +
    '        due_date_ymd,\n' +
    '        false AS is_paid\n' +
    '      FROM unpaid_billing\n' +
    '    ',
