# Local dev: point to local backend so you see same DB as terminal (e.g. production if .env has prod DB)
VITE_API_BASE_URL=http://localhost:3000/api/sms

# Pay via FIUU tab (Invoice Record Payment + AR Create Step 2)
# Overrides root .env when running `npm run dev`
VITE_FIUU_PAYMENT_UI_ENABLED=true

# Lesson Plans (Teacher + verifier sidebar, routes, Settings tab)
# Overrides root .env when running `npm run dev`
VITE_LESSON_PLANS_ENABLED=true
